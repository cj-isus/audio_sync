# ===============================================================================
# КОНФИГУРАЦИЯ KTLINT ДЛЯ РОССИЙСКИХ СТАНДАРТОВ КОДА
# Проект: АудиоСинхронизатор
# ===============================================================================
# Данный файл определяет правила форматирования Kotlin кода в соответствии
# с российскими стандартами разработки и требованиями ГОСТ
# ===============================================================================

[*.{kt,kts}]

# ===============================================================================
# ОСНОВНЫЕ НАСТРОЙКИ ФОРМАТИРОВАНИЯ
# ===============================================================================

# Максимальная длина строки (соответствует ГОСТ Р 50.1.028-2001)
ktlint_standard_max-line-length = 120

# Отступы пробелами (стандарт российской индустрии)
indent_size = 4
indent_style = space

# ===============================================================================
# ПРАВИЛА ДЛЯ РУССКИХ ИДЕНТИФИКАТОРОВ
# ===============================================================================

# Разрешаем использование кириллических символов в идентификаторах
ktlint_standard_class-naming = disabled
ktlint_standard_function-naming = disabled  
ktlint_standard_property-naming = disabled
ktlint_standard_package-name = disabled

# ===============================================================================
# НАСТРОЙКИ ДЛЯ РУССКИХ КОММЕНТАРИЕВ
# ===============================================================================

# Настройки для комментариев на русском языке
ktlint_standard_comment-spacing = enabled
ktlint_standard_comment-wrapping = disabled  # Отключаем автоперенос русских комментариев

# ===============================================================================
# ФОРМАТИРОВАНИЕ СТРОК И ЛИТЕРАЛОВ
# ===============================================================================

# Разрешаем длинные строки для русских сообщений об ошибках
ktlint_standard_string-template = disabled

# ===============================================================================
# ИМПОРТЫ И ПАКЕТЫ
# ===============================================================================

# Сортировка импортов с учётом русской структуры пакетов
ktlint_standard_import-ordering = enabled

# Разрешаем пакеты с русскими названиями
ktlint_standard_package-name = disabled

# ===============================================================================
# ФУНКЦИИ И КЛАССЫ
# ===============================================================================

# Настройки для функций с русскими названиями
ktlint_standard_function-signature = enabled
ktlint_standard_parameter-list-wrapping = normal

# Классы с русскими названиями
ktlint_standard_class-signature = enabled

# ===============================================================================
# АННОТАЦИИ
# ===============================================================================

# Форматирование аннотаций (важно для Hilt и других DI фреймворков)
ktlint_standard_annotation = enabled
ktlint_standard_annotation-spacing = enabled

# ===============================================================================
# ЦЕПОЧКИ ВЫЗОВОВ
# ===============================================================================

# Настройки для builder-паттернов и DSL (важно для Compose)
ktlint_standard_chain-wrapping = enabled
ktlint_standard_multiline-if-else = enabled

# ===============================================================================
# СПЕЦИАЛЬНЫЕ ПРАВИЛА ДЛЯ ПРОЕКТА
# ===============================================================================

# Разрешаем использование подчёркиваний в константах на русском
ktlint_standard_property-naming = disabled

# Настройки для enum классов с русскими значениями
ktlint_standard_enum-entry-name-case = disabled

# ===============================================================================
# ОТКЛЮЧЁННЫЕ ПРАВИЛА ДЛЯ РУСИФИКАЦИИ
# ===============================================================================

# Отключаем правила, которые конфликтуют с русскими названиями
disabled_rules = class-naming,function-naming,property-naming,package-name,enum-entry-name-case

# ===============================================================================
# НАСТРОЙКИ СОВМЕСТИМОСТИ
# ===============================================================================

# Обеспечиваем совместимость с российскими IDE и инструментами
ktlint_code_style = intellij_idea

# Используем русскую локаль для сообщений об ошибках (если поддерживается)
ktlint_locale = ru_RU