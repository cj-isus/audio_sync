<?xml version="1.0" encoding="utf-8"?>
<!-- 
 ================================================================================================
 МАНИФЕСТ ПРИЛОЖЕНИЯ АУДИОСИНХРОНИЗАТОР
 Многоустройственная синхронная стерео-система для Android
 
 Определяет разрешения, компоненты и требования к системе для корректной работы приложения
 ================================================================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 
    ============================================================================================
    РАЗРЕШЕНИЯ ДЛЯ АУДИО ОБРАБОТКИ
    Необходимы для воспроизведения, записи и обработки аудио потоков
    ============================================================================================
    -->
    
    <!-- Разрешение на запись аудио (микрофон) для анализа задержек и калибровки -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- Специальное разрешение для захвата системного аудио (Android 10+) -->
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT" 
        tools:ignore="ProtectedPermissions" />
    
    <!-- Изменение настроек аудио системы (громкость, маршрутизация звука) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    
    <!-- Предотвращение засыпания устройства во время синхронизации аудио -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 
    ============================================================================================
    СЕТЕВЫЕ РАЗРЕШЕНИЯ
    Обеспечивают связь между устройствами через Wi-Fi и интернет
    ============================================================================================
    -->
    
    <!-- Доступ к интернету для загрузки аудио контента и синхронизации -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Проверка состояния сетевого подключения -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Изменение сетевых настроек для оптимизации соединения -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    
    <!-- Доступ к информации о Wi-Fi сетях -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    
    <!-- Управление Wi-Fi соединениями -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- 
    ============================================================================================
    WI-FI DIRECT РАЗРЕШЕНИЯ
    Прямое соединение между устройствами без роутера для минимальных задержек
    ============================================================================================
    -->
    
    <!-- Точная геолокация необходима для Wi-Fi Direct в Android 6+ -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    
    <!-- Приблизительная геолокация как fallback для старых устройств -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 
    ============================================================================================
    BLUETOOTH РАЗРЕШЕНИЯ
    Для Bluetooth LE Audio и классического Bluetooth как резервного канала
    ============================================================================================
    -->
    
    <!-- Классические Bluetooth разрешения (Android < 12) -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    
    <!-- Новые Bluetooth разрешения для Android 12+ -->
    <!-- Подключение к Bluetooth устройствам -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    
    <!-- Объявление Bluetooth сервисов для обнаружения другими устройствами -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    
    <!-- Сканирование Bluetooth устройств -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- 
    ============================================================================================
    РАЗРЕШЕНИЯ ДЛЯ КАМЕРЫ И QR-КОДОВ
    Необходимы для сканирования QR-кодов для подключения устройств
    ============================================================================================
    -->
    
    <!-- Доступ к камере для сканирования QR-кодов -->
    <uses-permission android:name="android.permission.CAMERA" />
    
    <!-- Разрешения для Wi-Fi и Bluetooth -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    
    <!-- Для Android 12+ -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    
    <!-- 
    ============================================================================================
    РАЗРЕШЕНИЯ ДЛЯ ПРОГРАММНОГО УПРАВЛЕНИЯ НАСТРОЙКАМИ
    Позволяют включать/выключать Wi-Fi, Bluetooth и другие функции из приложения
    ============================================================================================
    -->
    
    <!-- Управление точкой доступа Wi-Fi -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    
    <!-- Управление системными настройками -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" 
        tools:ignore="ProtectedPermissions" />
    
    <!-- Управление Bluetooth адаптером -->
    <uses-permission android:name="android.permission.BLUETOOTH_PRIVILEGED" 
        tools:ignore="ProtectedPermissions" />
    
    <!-- 
    ============================================================================================
    РАЗРЕШЕНИЯ ДЛЯ ИНТЕГРАЦИИ С МУЗЫКАЛЬНЫМИ ПРИЛОЖЕНИЯМИ
    Позволяют управлять воспроизведением музыки и получать информацию о треках
    ============================================================================================
    -->
    
    <!-- Управление медиа-сессиями для интеграции с музыкальными приложениями -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" 
        tools:ignore="ProtectedPermissions" />
    
    <!-- Доступ к медиа-библиотеке -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    
    <!-- Уведомления о медиа-сессиях -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" 
        tools:ignore="ProtectedPermissions" />
    
    <!-- Разрешение на доступ к медиа-сессиям (Android 5.0+) -->
    <uses-permission android:name="android.permission.MEDIA_SESSION_SERVICE" />
    
    <!-- Разрешение на управление медиа-сессиями -->
    <uses-permission android:name="android.permission.MEDIA_SESSION_SERVICE" />

    <!-- 
    ============================================================================================
    ТРЕБОВАНИЯ К АППАРАТНОМУ ОБЕСПЕЧЕНИЮ
    Определяют минимальные требования для работы приложения
    ============================================================================================
    -->
    
    <!-- Wi-Fi Direct обязателен для основного канала связи -->
    <uses-feature android:name="android.hardware.wifi.direct" android:required="true" />
    
    <!-- Bluetooth LE обязателен для резервного канала и новых аудио возможностей -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    
    <!-- Микрофон опционален (нужен только для калибровки задержек) -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- 
    ============================================================================================
    КОНФИГУРАЦИЯ ПРИЛОЖЕНИЯ
    Основные настройки приложения и его компонентов
    ============================================================================================
    -->
    <application
        android:name=".AudioSynchronizerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AudioSynchronizer"
        tools:targetApi="31">

        <!-- 
        ========================================================================================
        ГЛАВНАЯ АКТИВНОСТЬ
        Точка входа в приложение с Jetpack Compose UI
        ========================================================================================
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AudioSynchronizer">
            
            <!-- Intent фильтр для запуска приложения с рабочего стола -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 
        ========================================================================================
        ФОНОВЫЕ СЕРВИСЫ
        Обеспечивают работу синхронизации и обнаружения устройств в фоне
        ========================================================================================
        -->
        
        <!-- Сервисы удалены для упрощения архитектуры -->

    </application>
</manifest>