<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- 
    ============================================================================================
    ПРАВИЛА РЕЗЕРВНОГО КОПИРОВАНИЯ
    ============================================================================================
    Определяет какие данные приложения включать/исключать из резервного копирования
    ============================================================================================
    -->
    
    <!-- Исключить временные файлы -->
    <exclude domain="file" path="temp/" />
    <exclude domain="file" path="cache/" />
    
    <!-- Исключить аудио кэш -->
    <exclude domain="file" path="audio_cache/" />
    
    <!-- Исключить логи -->
    <exclude domain="file" path="logs/" />
    
    <!-- Включить пользовательские настройки -->
    <include domain="sharedpref" path="user_preferences.xml" />
    
    <!-- Включить сохранённые конфигурации сети -->
    <include domain="sharedpref" path="network_config.xml" />
</full-backup-content>
